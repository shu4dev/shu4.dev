---
/**
 * Night-mode meteor shower.
 * Mounted twice:
 *   <Rain />                   in Base.astro, next to <canvas id="rain">: hosts the draw loop, renders no markup
 *   <Rain variant="control" /> in the header's .site-tools, right before <ThemeToggle />: the "meteors" slider
 * The canvas is fixed behind the content (z-index 0, below .page) and covers the whole viewport; streaks behind
 * <main> draw at 0.55 alpha. Runs only while <html data-theme="night">, the slider is above 0, the tab is visible
 * and the user has not asked for reduced motion. Logic lives in src/scripts/rain.ts.
 * Slider: input#rain-slider, 0-100 (default 50), persisted in localStorage "rain"; sets how many meteors fly at once.
 */
interface Props {
  variant?: 'canvas' | 'control';
}

const { variant = 'canvas' } = Astro.props;
---

{
  variant === 'control' && (
    <div class="rain-control">
      <label class="mono" for="rain-slider">meteors</label>
      <input id="rain-slider" type="range" min="0" max="100" step="1" value="50" aria-valuetext="50 of 100" />
    </div>
  )
}

<script>
  import { startRain } from '../scripts/rain';

  startRain();
</script>

<style is:global>
  #rain {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    pointer-events: none;
  }

  /* Night-only pill in the header, beside the theme toggle: the same 2.25rem height, on the ground colour so
     meteors passing behind the header do not cross the label or track. */
  .rain-control {
    display: none;
    align-items: center;
    gap: var(--space-2);
    block-size: 2.25rem;
    padding-inline: var(--space-3) var(--space-2);
    border: 1px solid var(--hairline);
    border-radius: 999px;
    background: var(--ground);
    color: var(--muted);
  }

  :root[data-theme='night'] .rain-control {
    display: flex;
  }

  @media (prefers-reduced-motion: reduce) {
    :root[data-theme='night'] .rain-control {
      display: none;
    }
  }

  .rain-control label {
    font-size: var(--fs-mono-sm);
    line-height: 1;
    letter-spacing: var(--tracking-mono);
    color: inherit;
    white-space: nowrap;
    cursor: pointer;
    user-select: none;
  }

  /* Native range input, restyled: hairline track, ink fill, small round thumb. --rain-fill is set by the script. */
  #rain-slider {
    --track: 2px;
    --thumb: 0.75rem;
    --track-color: rgb(217 225 230 / 0.28);
    --fill-color: var(--ink);
    --rain-fill: 50%;

    appearance: none;
    inline-size: 6rem;
    block-size: 100%;
    margin: 0;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: transparent;
    cursor: pointer;
  }

  @media (hover: hover) {
    .rain-control:hover {
      color: var(--ink);
    }
  }

  /* touch: a bigger thumb and a 44px-tall pill */
  @media (pointer: coarse) {
    .rain-control {
      block-size: 2.75rem;
    }

    #rain-slider {
      --thumb: 1rem;
    }
  }

  #rain-slider::-webkit-slider-runnable-track {
    block-size: var(--track);
    border: 0;
    border-radius: 999px;
    background: linear-gradient(to right, var(--fill-color) var(--rain-fill), var(--track-color) var(--rain-fill));
  }

  #rain-slider::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    inline-size: var(--thumb);
    block-size: var(--thumb);
    margin-block-start: calc((var(--track) - var(--thumb)) / 2);
    border: 0;
    border-radius: 50%;
    background: var(--fill-color);
    transition: scale var(--dur-fast) var(--ease-out);
  }

  #rain-slider:active::-webkit-slider-thumb {
    scale: 1.2;
  }

  #rain-slider::-moz-range-track {
    block-size: var(--track);
    border: 0;
    border-radius: 999px;
    background: var(--track-color);
  }

  #rain-slider::-moz-range-progress {
    block-size: var(--track);
    border-radius: 999px;
    background: var(--fill-color);
  }

  #rain-slider::-moz-range-thumb {
    inline-size: var(--thumb);
    block-size: var(--thumb);
    border: 0;
    border-radius: 50%;
    background: var(--fill-color);
  }

  /* the focus ring goes round the whole pill, not just the track */
  #rain-slider:focus-visible {
    outline: none;
  }

  .rain-control:has(#rain-slider:focus-visible) {
    outline: 2px solid var(--focus);
    outline-offset: 2px;
  }
</style>
