---
/**
 * Project cards on the home page, in collection order: thumbnail (Hero thumb) left, text right
 * (year · tags, title linking to /projects/<id>/, summary, links). Card layout lives in global.css (.card).
 */
import type { CollectionEntry } from 'astro:content';
import Hero from './Hero.astro';

interface Props {
  projects: CollectionEntry<'projects'>[];
}

const { projects } = Astro.props;

// frontmatter labels read "Paper (arXiv:...)": the row shows the part before the brackets,
// or the whole label when that part is already taken (Fiatlux's external "Project page")
function rowLinks(links: { label: string; href: string }[]) {
  const seen = new Set(['Project page']);
  return links.map((l) => {
    const short = l.label.replace(/\s*\(.*\)$/, '');
    const text = seen.has(short) ? l.label : short;
    seen.add(short);
    return { href: l.href, text };
  });
}
---

<ol class="card-list" role="list">
  {
    projects.map((p) => (
      <li class="card">
        <div class="card-thumb">
          <Hero hero={p.data.hero} thumb />
        </div>
        <div class="card-body">
          <p class="card-meta mono">{[p.data.year, ...p.data.tags].join(' · ')}</p>
          <h3 class="card-title">
            <a href={`/projects/${p.id}/`}>{p.data.title}</a>
          </h3>
          <p>{p.data.summary}</p>
          <ul class="card-links" role="list">
            <li>
              <a href={`/projects/${p.id}/`}>Project page</a>
            </li>
            {rowLinks(p.data.links).map((l) => (
              <li>
                <a href={l.href}>{l.text}</a>
              </li>
            ))}
          </ul>
        </div>
      </li>
    ))
  }
</ol>
