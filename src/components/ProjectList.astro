---
/**
 * Featured projects on the home page. Each row: title (link to /projects/<id>/), one line, year, tags.
 * The whole row is clickable through the title link's stretched ::after.
 */
import type { CollectionEntry } from 'astro:content';

interface Props {
  projects: CollectionEntry<'projects'>[];
}

const { projects } = Astro.props;
---

<ol class="project-list" role="list">
  {
    projects.map((p) => (
      <li class="project">
        <div class="project-head">
          <h3 class="project-title">
            <a href={`/projects/${p.id}/`}>{p.data.title}</a>
          </h3>
          <span class="project-year mono">{p.data.year}</span>
        </div>
        <p class="project-summary">{p.data.summary}</p>
        <ul class="tags" aria-label="Tags">
          {p.data.tags.map((t) => (
            <li class="tag">{t}</li>
          ))}
        </ul>
      </li>
    ))
  }
</ol>

<style>
  .project-list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-bottom: 1px solid var(--hairline);
  }

  .project {
    position: relative;
    display: grid;
    gap: var(--space-2);
    padding-block: var(--space-5);
    border-top: 1px solid var(--hairline);
  }

  .project-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .project-title {
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: -0.015em;
  }

  .project-title a {
    color: var(--ink);
  }

  .project-title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  @media (hover: hover) {
    .project:hover .project-title a {
      text-decoration-line: underline;
      text-decoration-color: var(--accent);
    }
  }

  .project-title a:focus-visible {
    outline: none;
  }

  .project-title a:focus-visible::after {
    outline: 2px solid var(--focus);
    outline-offset: 2px;
    border-radius: 2px;
  }

  .project-year {
    flex: none;
    color: var(--muted);
  }

  .project-summary {
    max-width: var(--measure);
    color: var(--ink);
  }
</style>
