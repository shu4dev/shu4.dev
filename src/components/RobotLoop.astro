---
/**
 * RobotLoop: an original line drawing of a small humanoid robot climbing a ladder, seen from behind.
 * Stroke only (currentColor, 1.5px, non-scaling), a 3.6 s CSS keyframe loop, transform-only.
 *
 * Shown in the pinned panel while the hero media loads (Hero.astro hides .hero-placeholder once
 * [data-hero][data-state="ready"]; the loop pauses then) and large on the About page.
 *
 * Props:
 *   class       passthrough (callers size it, e.g. .hero-robot, .about-robot)
 *   size        optional CSS width (number = px); height follows the 2:3 viewBox
 *   label       accessible name; giving one makes the drawing an img
 *   decorative  default true unless label is given; decorative = aria-hidden
 *
 * Motion: the figure climbs in place. The rungs slide down one spacing (24) every half loop
 * while hands and feet alternate rungs in a four-beat order (right hand, left foot, left hand,
 * right foot); a gripping hand or foot rides its rung down, then reaches up to the next free one.
 * Joint angles are inverse-kinematics samples every 4 % of the loop (frame 0 = the drawn pose), so
 * gripping ends stay on their rung to within 0.1 unit. Right limbs reuse the left keyframes,
 * mirrored and half a loop out of phase. Reduced motion: every animation is paused on frame 0.
 */
interface Props {
  class?: string;
  size?: string | number;
  label?: string;
  decorative?: boolean;
}

const { class: className, size, label, decorative } = Astro.props;
const isDecorative = decorative ?? !label;
const name = label ?? 'Line drawing of a robot climbing a ladder';
const width = typeof size === 'number' ? `${size}px` : size;
// unique per instance so two drawings on one page never share mask ids
const uid = `rl-${Math.random().toString(36).slice(2, 8)}`;
---

<svg
  class:list={['robot-loop', className]}
  viewBox="0 0 160 240"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  role={isDecorative ? undefined : 'img'}
  aria-label={isDecorative ? undefined : name}
  aria-hidden={isDecorative ? 'true' : undefined}
  focusable="false"
  style={width ? `width: ${width}` : undefined}
>
  <defs>
    <linearGradient id={`${uid}-fade`} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#000" />
      <stop offset="0.16" stop-color="#fff" />
      <stop offset="0.84" stop-color="#fff" />
      <stop offset="1" stop-color="#000" />
    </linearGradient>
    <!-- ladder fades out top and bottom, and breaks where it passes behind the head and torso -->
    <mask id={`${uid}-mask`} maskUnits="userSpaceOnUse" x="0" y="0" width="160" height="240">
      <rect width="160" height="240" fill={`url(#${uid}-fade)`} stroke="none" />
      <g fill="#000" stroke="#000" stroke-width="8">
        <rect x="71" y="53" width="18" height="18" rx="5" />
        <path d="M67 77H93Q96.5 77 96 80.5L92.6 104.5Q92.2 107 89.6 107H70.4Q67.8 107 67.4 104.5L64 80.5Q63.5 77 67 77Z" />
        <path d="M71 114.5H89Q91 114.5 90.6 116.5L89.2 123Q88.8 125 86.8 125H73.2Q71.2 125 70.8 123L69.4 116.5Q69 114.5 71 114.5Z" />
      </g>
    </mask>
  </defs>

  <g class="rl-ladder" mask={`url(#${uid}-mask)`}>
    <path d="M34 -8V248M126 -8V248" />
    <g class="rl-anim rl-rungs">
      <path d="M34 -62.64H126M34 -38.64H126M34 -14.64H126M34 9.36H126M34 33.36H126M34 57.36H126M34 81.36H126M34 105.36H126M34 129.36H126M34 153.36H126M34 177.36H126M34 201.36H126M34 225.36H126M34 249.36H126" />
    </g>
  </g>

  <g class="rl-anim rl-body">
    <g class="rl-anim rl-hip rl-leg-l">
        <circle cx="73" cy="127.3" r="2.3" />
        <path d="M71.76 129.23 L60.56 146.65" />
        <g class="rl-anim rl-knee">
          <circle cx="59.48" cy="148.33" r="2" />
          <path d="M59.35 150.32 L57.85 173.28" />
          <g class="rl-anim rl-ankle"><rect x="53.85" y="173.28" width="8" height="4.5" rx="1.5" /></g>
        </g>
      </g>
    <g class="rl-r" transform="matrix(-1 0 0 1 160 0)">
      <g class="rl-anim rl-hip rl-leg-r">
        <circle cx="73" cy="127.3" r="2.3" />
        <path d="M71.76 129.23 L60.56 146.65" />
        <g class="rl-anim rl-knee">
          <circle cx="59.48" cy="148.33" r="2" />
          <path d="M59.35 150.32 L57.85 173.28" />
          <g class="rl-anim rl-ankle"><rect x="53.85" y="173.28" width="8" height="4.5" rx="1.5" /></g>
        </g>
      </g>
    </g>
    <path d="M71 114.5H89Q91 114.5 90.6 116.5L89.2 123Q88.8 125 86.8 125H73.2Q71.2 125 70.8 123L69.4 116.5Q69 114.5 71 114.5Z" />
    <circle cx="80" cy="110.75" r="2.4" />
    <path d="M67 77H93Q96.5 77 96 80.5L92.6 104.5Q92.2 107 89.6 107H70.4Q67.8 107 67.4 104.5L64 80.5Q63.5 77 67 77Z" />
    <rect x="73.5" y="81.5" width="13" height="14" rx="2.5" />
    <path d="M80 99V104" />
    <g class="rl-anim rl-head">
      <path d="M80 71.5V76.5" />
      <rect x="71" y="53" width="18" height="18" rx="5" />
    </g>
    <g class="rl-anim rl-shoulder rl-arm-l">
        <circle cx="62" cy="81.5" r="2.4" />
        <path d="M59.63 81.09 L42.29 78.12" />
        <g class="rl-anim rl-elbow">
          <circle cx="40.32" cy="77.78" r="2" />
          <path d="M41.59 76.24 L53.98 61.18" />
          <g class="rl-anim rl-wrist"><rect x="50.98" y="55.68" width="6" height="5.5" rx="1.8" /></g>
        </g>
      </g>
    <g class="rl-r" transform="matrix(-1 0 0 1 160 0)">
      <g class="rl-anim rl-shoulder rl-arm-r">
        <circle cx="62" cy="81.5" r="2.4" />
        <path d="M59.63 81.09 L42.29 78.12" />
        <g class="rl-anim rl-elbow">
          <circle cx="40.32" cy="77.78" r="2" />
          <path d="M41.59 76.24 L53.98 61.18" />
          <g class="rl-anim rl-wrist"><rect x="50.98" y="55.68" width="6" height="5.5" rx="1.8" /></g>
        </g>
      </g>
    </g>
  </g>
</svg>

<style>
  .robot-loop {
    --rl-dur: 3.6s;
    display: block;
    width: 100%;
    height: auto;
    overflow: hidden;
  }

  /* 1.5px on screen at any size (the mask shapes keep their user-unit width) */
  .rl-ladder :is(path),
  .rl-body :is(path, rect, circle) {
    vector-effect: non-scaling-stroke;
  }

  .rl-ladder {
    stroke-opacity: 0.5;
  }

  /* transform-box: view-box so each joint pivots on its drawn coordinate inside its parent limb
     (fill-box would move the pivot as nested children rotate) */
  .rl-anim {
    transform-box: view-box;
    animation-duration: var(--rl-dur);
    animation-timing-function: linear;
    animation-iteration-count: infinite;
  }

  .rl-rungs {
    animation-name: rl-rungs;
    animation-duration: calc(var(--rl-dur) / 2);
  }
  .rl-body {
    animation-name: rl-body;
    transform-origin: 80px 118px;
  }
  .rl-head {
    animation-name: rl-head;
    transform-origin: 80px 74px;
  }
  .rl-shoulder {
    animation-name: rl-shoulder;
    transform-origin: 62px 81.5px;
  }
  .rl-elbow {
    animation-name: rl-elbow;
    transform-origin: 40.32px 77.78px;
  }
  .rl-wrist {
    animation-name: rl-wrist;
    transform-origin: 53.98px 61.18px;
  }
  .rl-hip {
    animation-name: rl-hip;
    transform-origin: 73px 127.3px;
  }
  .rl-knee {
    animation-name: rl-knee;
    transform-origin: 59.48px 148.33px;
  }
  .rl-ankle {
    animation-name: rl-ankle;
    transform-origin: 57.85px 173.28px;
  }

  /* right limbs: mirrored copies of the left ones, half a loop out of phase */
  .rl-r .rl-anim {
    animation-delay: calc(var(--rl-dur) / -2);
  }

  /* the hero placeholder is hidden once the media can play: stop drawing frames */
  :global(.hero[data-state='ready']) .rl-anim {
    animation-play-state: paused;
  }

  @media (prefers-reduced-motion: reduce) {
    .rl-anim {
      animation-play-state: paused;
    }
  }

  @keyframes rl-rungs {
    to {
      transform: translateY(24px);
    }
  }
  @keyframes rl-body {
    0%{transform:translate(-0.9px,-1.57px) rotate(-1.09deg)} 4%{transform:translate(-0.77px,-1.57px) rotate(-0.92deg)} 8%{transform:translate(-0.59px,-1.38px) rotate(-0.71deg)}
    12%{transform:translate(-0.37px,-1.05px) rotate(-0.44deg)} 16%{transform:translate(-0.13px,-0.65px) rotate(-0.15deg)} 20%{transform:translate(0.13px,-0.29px) rotate(0.15deg)}
    24%{transform:translate(0.37px,-0.06px) rotate(0.44deg)} 28%{transform:translate(0.59px,-0.01px) rotate(0.71deg)} 32%{transform:translate(0.77px,-0.15px) rotate(0.92deg)}
    36%{transform:translate(0.9px,-0.46px) rotate(1.09deg)} 40%{transform:translate(0.98px,-0.85px) rotate(1.18deg)} 44%{transform:translate(1px,-1.23px) rotate(1.2deg)}
    48%{transform:translate(0.95px,-1.5px) rotate(1.14deg)} 52%{transform:translate(0.84px,-1.6px) rotate(1.01deg)} 56%{transform:translate(0.68px,-1.5px) rotate(0.82deg)}
    60%{transform:translate(0.48px,-1.23px) rotate(0.58deg)} 64%{transform:translate(0.25px,-0.85px) rotate(0.3deg)} 68%{transform:translate(0px,-0.46px) rotate(0deg)}
    72%{transform:translate(-0.25px,-0.15px) rotate(-0.3deg)} 76%{transform:translate(-0.48px,-0.01px) rotate(-0.58deg)} 80%{transform:translate(-0.68px,-0.06px) rotate(-0.82deg)}
    84%{transform:translate(-0.84px,-0.29px) rotate(-1.01deg)} 88%{transform:translate(-0.95px,-0.65px) rotate(-1.14deg)} 92%{transform:translate(-1px,-1.05px) rotate(-1.2deg)}
    96%{transform:translate(-0.98px,-1.38px) rotate(-1.18deg)} 100%{transform:translate(-0.9px,-1.57px) rotate(-1.09deg)}
  }
  @keyframes rl-head {
    0%{transform:rotate(1.6deg)} 4%{transform:rotate(1.6deg)} 8%{transform:rotate(1.5deg)} 12%{transform:rotate(1.3deg)} 16%{transform:rotate(1.1deg)}
    20%{transform:rotate(0.7deg)} 24%{transform:rotate(0.4deg)} 28%{transform:rotate(0deg)} 32%{transform:rotate(-0.4deg)} 36%{transform:rotate(-0.8deg)}
    40%{transform:rotate(-1.1deg)} 44%{transform:rotate(-1.4deg)} 48%{transform:rotate(-1.5deg)} 52%{transform:rotate(-1.6deg)} 56%{transform:rotate(-1.6deg)}
    60%{transform:rotate(-1.4deg)} 64%{transform:rotate(-1.2deg)} 68%{transform:rotate(-0.9deg)} 72%{transform:rotate(-0.5deg)} 76%{transform:rotate(-0.2deg)}
    80%{transform:rotate(0.2deg)} 84%{transform:rotate(0.6deg)} 88%{transform:rotate(1deg)} 92%{transform:rotate(1.3deg)} 96%{transform:rotate(1.5deg)}
    100%{transform:rotate(1.6deg)}
  }
  @keyframes rl-shoulder {
    0%{transform:rotate(0deg)} 4%{transform:rotate(-5.4deg)} 8%{transform:rotate(-10.9deg)} 12%{transform:rotate(-16.6deg)} 16%{transform:rotate(-22.6deg)}
    20%{transform:rotate(-29.2deg)} 24%{transform:rotate(-36.7deg)} 28%{transform:rotate(-36.9deg)} 32%{transform:rotate(-33.5deg)} 36%{transform:rotate(-27.8deg)}
    40%{transform:rotate(-20.5deg)} 44%{transform:rotate(-12.3deg)} 48%{transform:rotate(-3.4deg)} 52%{transform:rotate(5.7deg)} 56%{transform:rotate(14.9deg)}
    60%{transform:rotate(23.5deg)} 64%{transform:rotate(30.6deg)} 68%{transform:rotate(35.2deg)} 72%{transform:rotate(31.6deg)} 76%{transform:rotate(28deg)}
    80%{transform:rotate(24.1deg)} 84%{transform:rotate(19.9deg)} 88%{transform:rotate(15.3deg)} 92%{transform:rotate(10.4deg)} 96%{transform:rotate(5.3deg)}
    100%{transform:rotate(0deg)}
  }
  @keyframes rl-elbow {
    0%{transform:rotate(0deg)} 4%{transform:rotate(5.1deg)} 8%{transform:rotate(9.4deg)} 12%{transform:rotate(13deg)} 16%{transform:rotate(16.1deg)}
    20%{transform:rotate(19deg)} 24%{transform:rotate(21.7deg)} 28%{transform:rotate(17.7deg)} 32%{transform:rotate(12.2deg)} 36%{transform:rotate(5.7deg)}
    40%{transform:rotate(-1.8deg)} 44%{transform:rotate(-10deg)} 48%{transform:rotate(-19.1deg)} 52%{transform:rotate(-28.8deg)} 56%{transform:rotate(-38.9deg)}
    60%{transform:rotate(-48.5deg)} 64%{transform:rotate(-56.2deg)} 68%{transform:rotate(-59.6deg)} 72%{transform:rotate(-51.7deg)} 76%{transform:rotate(-43.9deg)}
    80%{transform:rotate(-36.1deg)} 84%{transform:rotate(-28.1deg)} 88%{transform:rotate(-20.3deg)} 92%{transform:rotate(-12.8deg)} 96%{transform:rotate(-6deg)}
    100%{transform:rotate(0deg)}
  }
  @keyframes rl-wrist {
    0%{transform:rotate(1.1deg)} 4%{transform:rotate(1.2deg)} 8%{transform:rotate(2.2deg)} 12%{transform:rotate(4deg)} 16%{transform:rotate(6.6deg)}
    20%{transform:rotate(10.1deg)} 24%{transform:rotate(14.6deg)} 28%{transform:rotate(18.6deg)} 32%{transform:rotate(20.4deg)} 36%{transform:rotate(21deg)}
    40%{transform:rotate(21.1deg)} 44%{transform:rotate(21.1deg)} 48%{transform:rotate(21.4deg)} 52%{transform:rotate(22.1deg)} 56%{transform:rotate(23.2deg)}
    60%{transform:rotate(24.5deg)} 64%{transform:rotate(25.3deg)} 68%{transform:rotate(24.4deg)} 72%{transform:rotate(20.4deg)} 76%{transform:rotate(16.5deg)}
    80%{transform:rotate(12.8deg)} 84%{transform:rotate(9.3deg)} 88%{transform:rotate(6.2deg)} 92%{transform:rotate(3.7deg)} 96%{transform:rotate(1.9deg)}
    100%{transform:rotate(1.1deg)}
  }
  @keyframes rl-hip {
    0%{transform:rotate(0deg)} 4%{transform:rotate(2.4deg)} 8%{transform:rotate(9.3deg)} 12%{transform:rotate(17.9deg)} 16%{transform:rotate(26.9deg)}
    20%{transform:rotate(35.9deg)} 24%{transform:rotate(44.3deg)} 28%{transform:rotate(51.9deg)} 32%{transform:rotate(58.3deg)} 36%{transform:rotate(63deg)}
    40%{transform:rotate(65.6deg)} 44%{transform:rotate(65.4deg)} 48%{transform:rotate(60.2deg)} 52%{transform:rotate(55.6deg)} 56%{transform:rotate(51.6deg)}
    60%{transform:rotate(48.1deg)} 64%{transform:rotate(45deg)} 68%{transform:rotate(41.9deg)} 72%{transform:rotate(38.6deg)} 76%{transform:rotate(35deg)}
    80%{transform:rotate(30.9deg)} 84%{transform:rotate(26.2deg)} 88%{transform:rotate(21deg)} 92%{transform:rotate(15deg)} 96%{transform:rotate(8.3deg)}
    100%{transform:rotate(0deg)}
  }
  @keyframes rl-knee {
    0%{transform:rotate(0deg)} 4%{transform:rotate(-2.5deg)} 8%{transform:rotate(-13.2deg)} 12%{transform:rotate(-26.3deg)} 16%{transform:rotate(-39.6deg)}
    20%{transform:rotate(-51.8deg)} 24%{transform:rotate(-62.7deg)} 28%{transform:rotate(-71.9deg)} 32%{transform:rotate(-79.5deg)} 36%{transform:rotate(-85.2deg)}
    40%{transform:rotate(-89.2deg)} 44%{transform:rotate(-91.1deg)} 48%{transform:rotate(-86.6deg)} 52%{transform:rotate(-82.2deg)} 56%{transform:rotate(-78.1deg)}
    60%{transform:rotate(-74.4deg)} 64%{transform:rotate(-70.7deg)} 68%{transform:rotate(-67deg)} 72%{transform:rotate(-62.8deg)} 76%{transform:rotate(-57.9deg)}
    80%{transform:rotate(-52deg)} 84%{transform:rotate(-44.9deg)} 88%{transform:rotate(-36.5deg)} 92%{transform:rotate(-26.7deg)} 96%{transform:rotate(-15deg)}
    100%{transform:rotate(0deg)}
  }
  @keyframes rl-ankle {
    0%{transform:rotate(1.1deg)} 4%{transform:rotate(1deg)} 8%{transform:rotate(4.6deg)} 12%{transform:rotate(8.9deg)} 16%{transform:rotate(12.8deg)}
    20%{transform:rotate(15.8deg)} 24%{transform:rotate(17.9deg)} 28%{transform:rotate(19.3deg)} 32%{transform:rotate(20.2deg)} 36%{transform:rotate(21.1deg)}
    40%{transform:rotate(22.4deg)} 44%{transform:rotate(24.5deg)} 48%{transform:rotate(25.2deg)} 52%{transform:rotate(25.6deg)} 56%{transform:rotate(25.7deg)}
    60%{transform:rotate(25.7deg)} 64%{transform:rotate(25.5deg)} 68%{transform:rotate(25.1deg)} 72%{transform:rotate(24.5deg)} 76%{transform:rotate(23.4deg)}
    80%{transform:rotate(21.9deg)} 84%{transform:rotate(19.7deg)} 88%{transform:rotate(16.7deg)} 92%{transform:rotate(12.8deg)} 96%{transform:rotate(7.9deg)}
    100%{transform:rotate(1.1deg)}
  }
</style>
