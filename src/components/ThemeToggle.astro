---
/**
 * Sun/moon theme button (header, top right). Shows the current theme: sun by day, moon by night.
 * Contract: keeps id="theme-toggle"; theme changes go through window.__theme.set(); listeners are delegated
 * on document because the header is swapped on every ClientRouter navigation. Combo logic (a second click within
 * 500 ms undoes the first flip; 3 and 9 rapid clicks fire the night-only eggs): src/scripts/theme-toggle.ts.
 * The moon is also drawn as four clipped slices (hidden at rest) and three slash lines, used by the combo-3 effect.
 */
const MOON = 'M19.5 14.6A8 8 0 0 1 9.4 4.5a8 8 0 1 0 10.1 10.1Z';

// Cuts are the lines x + y = k (bottom-left to top-right). Slices lie between consecutive cuts.
const CUTS = [19.5, 24, 28.5];
const EDGES = [-40, ...CUTS, 90];
const slices = EDGES.slice(0, -1).map((a, i) => {
  const b = EDGES[i + 1];
  return `-20,${a + 20} 44,${a - 44} 44,${b - 44} -20,${b + 20}`;
});
// Each slash runs top-right to bottom-left along its cut, overshooting the 24-unit box slightly.
const slashes = CUTS.map((k) => {
  const x1 = Math.min(27, k + 3);
  const x2 = Math.max(-3, k - 27);
  return { x1, y1: k - x1, x2, y2: k - x2 };
});
---

<button id="theme-toggle" class="theme-toggle" type="button" aria-label="Switch theme" title="Switch theme">
  <svg class="icon-sun" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
    <circle cx="12" cy="12" r="4" />
    <path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4" />
  </svg>
  <svg class="icon-moon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" stroke-linecap="round">
    <defs>
      {
        slices.map((points, i) => (
          <clipPath id={`tt-slice-${i}`} clipPathUnits="userSpaceOnUse">
            <polygon points={points} />
          </clipPath>
        ))
      }
    </defs>
    <path class="moon-whole" d={MOON} />
    <g class="moon-slices">
      {
        slices.map((_, i) => (
          <g class="moon-slice" clip-path={`url(#tt-slice-${i})`}>
            <path d={MOON} />
          </g>
        ))
      }
    </g>
    <g class="moon-slashes">
      {slashes.map((s) => <line class="moon-slash" x1={s.x1} y1={s.y1} x2={s.x2} y2={s.y2} pathLength="1" />)}
    </g>
  </svg>
</button>

<script>
  import { initThemeToggle } from '../scripts/theme-toggle';

  initThemeToggle();
</script>

<style>
  .theme-toggle {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    margin: 0;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--muted);
    cursor: pointer;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
    /* rapid combo clicks must not select header text */
    -webkit-user-select: none;
    user-select: none;
    transition:
      color var(--dur-fast) ease,
      scale var(--dur-fast) var(--ease-out);
  }

  @media (hover: hover) {
    .theme-toggle:hover {
      color: var(--ink);
    }
  }

  .theme-toggle:active {
    scale: 0.92;
  }

  .theme-toggle svg {
    overflow: visible;
  }

  .icon-moon {
    display: none;
  }

  :global(:root[data-theme='night']) .icon-sun {
    display: none;
  }

  :global(:root[data-theme='night']) .icon-moon {
    display: block;
  }

  /* slices and slashes only exist for the combo-3 effect (data-cut is set while it runs) */
  .moon-slices {
    display: none;
  }

  .theme-toggle[data-cut] .moon-whole {
    display: none;
  }

  .theme-toggle[data-cut] .moon-slices {
    display: inline;
  }

  .moon-slash {
    stroke: #3dbe6a;
    stroke-width: 1.6;
    stroke-dasharray: 1 2;
    stroke-dashoffset: 1;
  }

  .theme-toggle[data-cut] .moon-slashes {
    filter: drop-shadow(0 0 1.5px rgb(61 190 106 / 0.8));
  }

  /* no JS, no toggle */
  :global(:root:not([data-theme])) .theme-toggle {
    display: none;
  }
</style>
