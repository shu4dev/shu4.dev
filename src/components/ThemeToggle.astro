---
/**
 * Sun/moon theme button (header .site-tools, after the rain control). Shows the current theme: sun by day, moon by night.
 * Contract: keeps id="theme-toggle"; theme changes go through window.__theme.set(); listeners are delegated on
 * document because the header is swapped on every ClientRouter navigation. Toggle and egg: src/scripts/theme-toggle.ts.
 */
---

<button id="theme-toggle" class="theme-toggle" type="button" aria-label="Switch theme" title="Switch theme">
  <svg class="icon-sun" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
    <circle cx="12" cy="12" r="4" />
    <path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4" />
  </svg>
  <svg class="icon-moon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" stroke-linecap="round">
    <path d="M19.5 14.6A8 8 0 0 1 9.4 4.5a8 8 0 1 0 10.1 10.1Z" />
  </svg>
</button>

<script>
  import { initThemeToggle } from '../scripts/theme-toggle';

  initThemeToggle();
</script>

<style>
  .theme-toggle {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    margin: 0;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--muted);
    cursor: pointer;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
    /* repeated clicks must not select header text */
    -webkit-user-select: none;
    user-select: none;
    transition:
      color var(--dur-fast) ease,
      scale var(--dur-fast) var(--ease-out);
  }

  @media (hover: hover) {
    .theme-toggle:hover {
      color: var(--ink);
    }
  }

  .theme-toggle:active {
    scale: 0.92;
  }

  .theme-toggle svg {
    overflow: visible;
  }

  .icon-moon {
    display: none;
  }

  :global(:root[data-theme='night']) .icon-sun {
    display: none;
  }

  :global(:root[data-theme='night']) .icon-moon {
    display: block;
  }

  /* no JS, no toggle */
  :global(:root:not([data-theme])) .theme-toggle {
    display: none;
  }
</style>
