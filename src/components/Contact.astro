---
/**
 * Contact links. variant="icons": a row of labelled icon links (home Contact section, footer).
 * variant="buttons": the home hero's link buttons, email first (accent fill, address written out), then the
 * profiles and the CV as hairline buttons.
 */
interface Props {
  variant?: 'icons' | 'buttons';
}

const { variant = 'icons' } = Astro.props;

const links = [
  {
    id: 'email',
    label: 'Email',
    href: 'mailto:brianshu0915@gmail.com',
    text: 'brianshu0915@gmail.com',
  },
  { id: 'github', label: 'GitHub', href: 'https://github.com/shu4dev', text: 'github.com/shu4dev' },
  {
    id: 'huggingface',
    label: 'Hugging Face',
    href: 'https://huggingface.co/shu4dev',
    text: 'huggingface.co/shu4dev',
  },
  {
    id: 'linkedin',
    label: 'LinkedIn',
    href: 'https://www.linkedin.com/in/brian-shu-1bb75b251',
    text: 'linkedin.com/in/brian-shu-1bb75b251',
  },
] as const;
---

{
  variant === 'icons' ? (
    <ul class="contact-icons" role="list">
      {links.map((l) => (
        <li>
          <a href={l.href} aria-label={l.label} title={l.label} rel={l.id === 'email' ? undefined : 'me'}>
            {l.id === 'email' && (
              <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="5.5" width="18" height="13" rx="1.5" />
                <path d="m3.5 6.5 8.5 6.5 8.5-6.5" />
              </svg>
            )}
            {l.id === 'github' && (
              <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="currentColor">
                <path d="M12 .3a12 12 0 0 0-3.8 23.38c.6.12.82-.26.82-.57v-2.03c-3.34.72-4.04-1.6-4.04-1.6-.55-1.4-1.34-1.77-1.34-1.77-1.08-.74.09-.73.09-.73 1.2.09 1.84 1.24 1.84 1.24 1.07 1.83 2.8 1.3 3.49 1 .1-.78.42-1.31.76-1.61-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.14-.3-.54-1.52.1-3.18 0 0 1-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.28-1.55 3.29-1.23 3.29-1.23.64 1.66.24 2.88.12 3.18a4.65 4.65 0 0 1 1.23 3.22c0 4.61-2.8 5.63-5.48 5.92.42.36.81 1.1.81 2.22v3.29c0 .32.21.69.82.57A12 12 0 0 0 12 .3" />
              </svg>
            )}
            {l.id === 'huggingface' && (
              <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="11" r="8" />
                <path d="M9 9.5v.5M15 9.5v.5" />
                <path d="M8.75 13a3.6 3.6 0 0 0 6.5 0" />
                <path d="M4.5 15.5 7 18a1.6 1.6 0 0 0 2.3-2.2l-.8-.8M19.5 15.5 17 18a1.6 1.6 0 0 1-2.3-2.2l.8-.8" />
              </svg>
            )}
            {l.id === 'linkedin' && (
              <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="currentColor">
                <path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13Zm1.78 13.02H3.56V9h3.56v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0Z" />
              </svg>
            )}
          </a>
        </li>
      ))}
    </ul>
  ) : (
    <ul class="contact-buttons" role="list">
      {links.map((l) => (
        <li>
          <a class:list={['btn', { 'btn-primary': l.id === 'email' }]} href={l.href} rel={l.id === 'email' ? undefined : 'me'}>
            {l.id === 'email' ? l.text : l.label}
          </a>
        </li>
      ))}
      <li>
        <a class="btn" href="/cv.pdf" data-astro-reload>CV</a>
      </li>
    </ul>
  )
}

<style>
  .contact-icons {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .contact-icons a {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 999px;
    color: var(--muted);
    transition: color var(--dur-fast) ease;
  }

  @media (hover: hover) {
    .contact-icons a:hover {
      color: var(--ink);
    }
  }

  .contact-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }
</style>
