---
/**
 * Project media by kind, filling its box (callers size the box: .project-media on project pages, .card-thumb on cards).
 *   video: muted loop with poster, no controls; played by the script below unless the user asked for reduced motion
 *   image: <img alt>
 *   svg:   the file under public/ inlined at build time, so it draws in currentColor and reads in both themes
 * thumb: card thumbnail. A video shows its poster instead, and images load lazily.
 */
import fs from 'node:fs';
import path from 'node:path';

interface Props {
  hero: {
    kind: 'video' | 'image' | 'svg';
    src: string;
    poster?: string;
    alt: string;
  };
  thumb?: boolean;
}

const { hero: h, thumb = false } = Astro.props;
const hero = thumb && h.kind === 'video' ? { ...h, kind: 'image' as const, src: h.poster ?? h.src } : h;

let svg = '';
if (hero.kind === 'svg') {
  const file = path.join(process.cwd(), 'public', hero.src.replace(/^\/+/, ''));
  svg = fs
    .readFileSync(file, 'utf8')
    .replace(/<\?xml[^>]*\?>/g, '')
    .replace(/<!DOCTYPE[^>]*>/gi, '')
    .replace(/<!--[\s\S]*?-->/g, '')
    .trim();
}
---

{
  hero.kind === 'video' && (
    <video
      class="media"
      data-loop
      muted
      loop
      playsinline
      preload="metadata"
      poster={hero.poster}
      aria-label={hero.alt}
      disablepictureinpicture
      disableremoteplayback
    >
      <source src={hero.src} type="video/mp4" />
    </video>
  )
}
{
  hero.kind === 'image' && (
    <img
      class="media"
      src={hero.src}
      alt={hero.alt}
      decoding="async"
      loading={thumb ? 'lazy' : undefined}
      fetchpriority={thumb ? undefined : 'high'}
    />
  )
}
{hero.kind === 'svg' && <div class="media media-svg" role="img" aria-label={hero.alt} set:html={svg} />}

<script>
  // play loops only when motion is allowed; astro:page-load fires on first load and after every navigation
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');

  function sync() {
    document.querySelectorAll<HTMLVideoElement>('video[data-loop]').forEach((v) => {
      if (reduce.matches) v.pause();
      else v.play().catch(() => {});
    });
  }

  document.addEventListener('astro:page-load', sync);
  reduce.addEventListener('change', sync);
</script>

<style>
  .media {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* block, not grid: the svg's 100% height must resolve against this box, and its viewBox letterboxes it */
  .media-svg {
    padding: clamp(0.5rem, 4%, 2rem);
    color: var(--ink);
  }

  .media-svg :global(svg) {
    width: 100%;
    height: 100%;
    overflow: visible;
  }
</style>
