---
/**
 * The split stage. Desktop (>= 960px): pinned panel (sticky, 100svh, 45%) left, scrolling column (55%) right.
 * Phones: panel on top at 40svh, column below.
 * Slots: "panel" (hero media) and default (the column's <main> content).
 * Props: same as Base (title, description, image, type, noindex).
 * Hooks: div#panel[data-panel] is the pinned panel (rain draws full density inside its rect). It is a size
 * container named "panel", so cq units inside it measure the panel (the night hero window's inset is 6cqmin).
 * .panel-media holds the slotted media at opacity var(--media-opacity) (an svg diagram instead dims itself on a
 * solid window, so no rain shows behind its labels); .panel-corner holds the rain slider,
 * kept inside the hero window's corner when there is one (it follows --media-inset).
 */
import Base, { type Props as BaseProps } from './Base.astro';
import Rain from '../components/Rain.astro';

type Props = BaseProps;
---

<Base {...Astro.props}>
  <div id="panel" class="panel" slot="panel" data-panel>
    <div class="panel-media">
      <slot name="panel" />
    </div>
    <div class="panel-corner">
      <Rain variant="control" />
    </div>
  </div>
  <slot />
</Base>

<style>
  .panel {
    position: relative;
    height: var(--panel-phone-height);
    min-height: 15rem;
    overflow: hidden;
    background: var(--panel-bg);
    container: panel / size;
  }

  @media (min-width: 960px) {
    .panel {
      position: sticky;
      top: 0;
      height: 100svh;
      min-height: 0;
    }
  }

  .panel-media {
    position: absolute;
    inset: 0;
    opacity: var(--media-opacity);
  }

  /* a diagram's window stays solid ground so no rain shows behind its labels; the drawing dims instead (Hero) */
  .panel-media:has(> [data-kind='svg']) {
    opacity: 1;
  }

  .panel-corner {
    position: absolute;
    right: var(--space-4);
    bottom: var(--space-4);
    z-index: 2;
  }

  /* with a hero, keep the slider inside the window's corner (at night the window is inset) */
  .panel:has([data-hero]) .panel-corner {
    right: calc(var(--media-inset) + var(--space-3));
    bottom: calc(var(--media-inset) + var(--space-3));
  }
</style>
