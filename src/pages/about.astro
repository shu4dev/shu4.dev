---
import Split from '../layouts/Split.astro';
import RobotLoop from '../components/RobotLoop.astro';
import Contact from '../components/Contact.astro';
import { Content, frontmatter } from '../content/about.md';
---

<Split title="About" description={frontmatter.description}>
  <div slot="panel" class="about-panel">
    <RobotLoop class="about-robot" />
  </div>

  <article class="about" aria-labelledby="about-title">
    <h1 id="about-title">About</h1>

    <div class="prose">
      <Content />
    </div>

    <section class="elsewhere" aria-labelledby="elsewhere-title">
      <h2 id="elsewhere-title">Elsewhere</h2>
      <Contact variant="full" />
      <p class="cv"><a href="/cv.pdf" data-astro-reload>Full CV (PDF)</a></p>
    </section>
  </article>
</Split>

<style>
  .about-panel {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    color: var(--ink);
  }

  .about-panel :global(.about-robot) {
    width: min(42%, 16rem);
  }

  .about {
    padding-top: var(--space-6);
  }

  .about h1 {
    margin-bottom: var(--space-6);
  }

  .elsewhere {
    margin-top: var(--space-8);
  }

  .elsewhere h2 {
    margin-bottom: var(--space-5);
  }

  .cv {
    margin-top: var(--space-5);
  }
</style>
