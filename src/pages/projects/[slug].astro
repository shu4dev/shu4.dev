---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';

export async function getStaticPaths() {
  const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
  return projects.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, next: projects[(i + 1) % projects.length] },
  }));
}

type Props = {
  entry: CollectionEntry<'projects'>;
  next: CollectionEntry<'projects'>;
};

const { entry, next } = Astro.props;
const { title, summary, year, tags, status, hero, links } = entry.data;
const { Content } = await render(entry);
---

<Base title={title} description={summary} type="article">
  <article class="project" aria-labelledby="project-title">
    <p><a class="back mono" href="/#projects">← All projects</a></p>

    <header class="project-header">
      <ul class="tags" aria-label="Tags">
        {tags.map((t) => <li class="tag">{t}</li>)}
      </ul>
      <h1 id="project-title">{title}</h1>
      <p class="lead">{summary}</p>
      <dl class="meta">
        <div>
          <dt class="mono">Year</dt>
          <dd class="mono">{year}</dd>
        </div>
        {
          status && (
            <div>
              <dt class="mono">Status</dt>
              <dd class="mono">{status}</dd>
            </div>
          )
        }
      </dl>
    </header>

    <div class="project-media" data-kind={hero.kind}>
      <Hero hero={hero} />
    </div>

    <div class="prose">
      <Content />
    </div>

    {
      links.length > 0 && (
        <section class="links" aria-labelledby="links-title">
          <h2 id="links-title">Links</h2>
          <ul role="list">
            {links.map((l) => (
              <li>
                <a href={l.href}>{l.label}</a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <nav class="next" aria-label="Next project">
      <span class="mono muted">Next project</span>
      <a href={`/projects/${next.id}/`}>{next.data.title} →</a>
    </nav>
  </article>
</Base>

<style>
  .project {
    padding-top: var(--space-3);
  }

  .back {
    color: var(--muted);
  }

  @media (hover: hover) {
    .back:hover {
      color: var(--ink);
    }
  }

  .project-header {
    display: grid;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-6);
    margin-top: var(--space-1);
  }

  .meta dt {
    color: var(--muted);
    font-size: var(--fs-mono-sm);
  }

  .meta dd {
    margin: 0;
    color: var(--ink);
  }

  /* full-width stage: 16:9 (4:3 on phones), never taller than 70vh; media contained on --surface */
  .project-media {
    width: 100%;
    aspect-ratio: 16 / 9;
    max-height: 70vh;
    margin-block: var(--space-6) var(--space-7);
    overflow: hidden;
    border: 1px solid var(--hairline);
    border-radius: 8px;
    background: var(--surface);
  }

  @media (max-width: 759px) {
    .project-media {
      aspect-ratio: 4 / 3;
    }
  }

  .project-media :global(.media) {
    object-fit: contain;
  }

  .links {
    max-width: var(--measure);
    margin-top: var(--space-7);
  }

  .links h2 {
    margin-bottom: var(--space-4);
  }

  .links ul {
    margin: 0;
    padding: 0;
    list-style: none;
    border-bottom: 1px solid var(--hairline);
  }

  .links li {
    padding-block: var(--space-3);
    border-top: 1px solid var(--hairline);
  }

  .next {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
    max-width: var(--measure);
    margin-top: var(--space-8);
  }

  .next a {
    font-weight: 500;
  }
</style>
